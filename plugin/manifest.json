{
  "manifestVersion": 5,
  "id": "com.marwane.cue.bridge",
  "name": "Cue Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://localhost:47821",
        "ws://127.0.0.1:47821",
        "ws://localhost",
        "ws://127.0.0.1"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cueBridgePanel",
      "label": { "default": "Cue Bridge" },
      "minimumSize": { "width": 240, "height": 260 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 380 },
      "preferredFloatingSize": { "width": 320, "height": 420 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
